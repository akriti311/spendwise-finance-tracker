# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env — it contains secrets.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=spendwise
# Linux/Docker: postgres | Mac (Homebrew): often your macOS username — or leave blank
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
# 5433 = SpendWise (Homebrew). Leave 5432 free for GraphSpace Docker.
DB_PORT=5433

# Optional: persistent DB connections (seconds). Use 60+ in production.
DB_CONN_MAX_AGE=0

# Optional: require | prefer | disable (use "require" on hosted Postgres)
DB_SSLMODE=prefer
